# Firebase App Distribution Configuration Template
# Copy this file to '.env.firebase' and fill in your app details.

# Your Android App ID from Firebase Console (Settings -> Project Settings -> General -> Your Apps)
FIREBASE_APP_ID_ANDROID="YOUR_ANDROID_APP_ID_HERE"

# Your iOS App ID from Firebase Console
FIREBASE_APP_ID_IOS="YOUR_IOS_APP_ID_HERE"

# Default tester groups (comma-separated, e.g. internal-testers)
FIREBASE_TESTERS_GROUP="internal-testers"
